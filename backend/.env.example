# Proxmox VE
PROXMOX_HOST=192.168.0.200
PROXMOX_PORT=8006
PROXMOX_USER=root@pam
PROXMOX_PASSWORD=changeme
PROXMOX_NODE=pve

# CORS — origin do frontend
ALLOWED_ORIGIN=http://192.168.0.133:8081

# NUT (UPS monitoring)
NUT_HOST=192.168.0.200
NUT_PORT=3493
NUT_USER=dashboard
NUT_PASSWORD=changeme
NUT_UPS_NAME=gembird
# Potencia real nominal (W) usada para estimar o consumo (ups.load x nominal) quando o NUT
# nao reporta ups.realpower. Opcional; omissao 720 (UPS 1200VA, fator de potencia ~0.6).
UPS_NOMINAL_WATTS=720

# GPU agent (NVML stats, runs on ai-local — GPU is passed through to this VM)
GPU_AGENT_URL=http://192.168.0.212:9092

# Raspberry Pi 1 agent (pi-agent). Token opcional para as ações start/stop do bridge Arduino/socat;
# tem de coincidir com AGENT_TOKEN no pi-agent do Pi 1. Vazio = sem token.
RASPBERRY_PI_AGENT_TOKEN=
